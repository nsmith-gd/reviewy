# Linux: run the worker at login as a user service.
#   cp deploy/debrief-worker.service ~/.config/systemd/user/ && systemctl --user enable --now debrief-worker
[Unit]
Description=Debrief review worker
After=network-online.target

[Service]
ExecStart=/usr/bin/env debrief worker
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
